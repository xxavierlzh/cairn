# Copy to .env (never commit .env). Every value here is a safe local-dev placeholder.

# Local MongoDB from `docker compose up -d` (see docker-compose.yml), or an Atlas
# connection string: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cairn
MONGODB_URI=mongodb://localhost:27017/cairn?directConnection=true

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Public URL of this API server.
BETTER_AUTH_URL=http://localhost:4000

# The web app's URL, trusted for auth requests.
WEB_ORIGIN=http://localhost:3000

# 0.0.0.0 so your phone can reach the API over Wi-Fi.
HOST=0.0.0.0
PORT=4000
